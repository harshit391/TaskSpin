generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#FF2D6F")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id             String    @id @default(cuid())
  title          String
  completed      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  recurrenceType      String?
  recurrenceDays      Int?
  recurrenceStartDate DateTime?
  hiddenUntil         DateTime?
  sourceTaskId        String?   @unique
  sourceTask          Task?     @relation("FollowUpChain", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  followUpTask        Task?     @relation("FollowUpChain")
}
