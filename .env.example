# Copy to .env and fill in. Never commit .env.

# Supabase Postgres (pooled connection for the app, direct for migrations)
DATABASE_URL=
DIRECT_URL=

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bearer token Vercel Cron sends to /api/cron/*. Without it the nightly jobs are rejected.
CRON_SECRET=

# Timezone for the daily stats cron and requests that don't send x-timezone. Default: Asia/Kolkata
# APP_TIMEZONE=Asia/Kolkata

# Local development only: skip login and act as this Supabase user ID.
# Ignored and stripped from the bundle in production builds.
# NEXT_PUBLIC_AUTH_BYPASS_USER_ID=
